{
  "name": "slay-braids-web",
  "version": "0.1.0",
  "private": true,
  "description": "Official SLAY BRAIDS website (FUTURA product line). M0 foundation + M1 3D prototype.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "npx serve out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "preview:build": "vite build --config preview/vite.config.ts",
    "anchors:render": "node scripts/render-anchors.mjs",
    "perf:lighthouse": "node scripts/lighthouse.mjs",
    "perf:bundle": "node scripts/bundle-report.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "lenis": "1.3.28",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "serve": "^14",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "type": "module"
}
